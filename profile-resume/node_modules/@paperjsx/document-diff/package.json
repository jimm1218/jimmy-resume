{
  "name": "@paperjsx/document-diff",
  "version": "0.0.8",
  "description": "Shared JSON schema diffing utilities for PaperJSX engines",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "homepage": "https://paperjsx.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/paperjsx/document-diff"
  },
  "bugs": "https://github.com/paperjsx/document-diff/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "node ../../scripts/pack-check.mjs",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm typecheck && pnpm test && pnpm pack:check"
  },
  "dependencies": {
    "jsondiffpatch": "^0.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
